# Copy to .env. Use your own licensed IPTV provider: an Xtream account or any M3U playlist.
# The source can also be set later from the app (Ligar fonte), which saves it in ./data.
APP_PIN=change-this-to-a-long-private-pin
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_DAYS=30
XTREAM_BASE=
XTREAM_USERNAME=
XTREAM_PASSWORD=
# Alternative to the three XTREAM_* fields above: one address, Xtream or any M3U/M3U8 playlist.
# Examples: https://provider.example/get.php?username=you&password=secret&type=m3u_plus
#           https://lists.example/tv.m3u
IPTV_URL=
# Or put a .url shortcut or a whole .m3u playlist in ./data and set /data/provider.url here.
IPTV_URL_FILE=
STREAM_VIDEO_CODEC=copy
STREAM_IDLE_SECONDS=90
# true by default. Set false only for an HTTP connection on a trusted LAN.
COOKIE_SECURE=true
# Public HTTPS address, needed only for Tesla Theater mode.
PUBLIC_BASE_URL=
# Docker host binding. Use 0.0.0.0 only when you intend LAN access.
LUMINA_BIND=127.0.0.1
LUMINA_PORT=8091
