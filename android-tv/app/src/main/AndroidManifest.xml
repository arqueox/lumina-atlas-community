<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- IPTV catalogues and streams. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ExoPlayer keeps the CPU and network awake while playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility: the launcher lists every TV app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/app_icon"
        android:banner="@drawable/app_banner"
        android:theme="@style/Theme.Noir"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density" />

        <!-- "A ver agora": with notification access, follows other apps' media sessions (see MediaWatcher). -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:label="Lumina Atlas: a ver agora"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Google TV keeps its own launcher on the Home button. When the user turns this service on in
             Accessibility, it sends them here whenever the Google TV home comes to the front. -->
        <service
            android:name=".HomeRedirectService"
            android:exported="false"
            android:label="Lumina Atlas: botão Home"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_redirect" />
        </service>
    </application>
</manifest>
